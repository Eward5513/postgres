--
-- trace_basic.sql
-- 基本数据加载和配置测试
--
-- directory paths are passed to us in environment variables
\getenv abs_srcdir PG_ABS_SRCDIR
-- 加载trace扩展
CREATE EXTENSION IF NOT EXISTS trace;
-- 测试1: 检查初始状态
SELECT 'Testing initial state' as test_phase;
     test_phase     
--------------------
 Testing initial state
(1 row)

-- 测试扩展是否正确加载
SELECT COUNT(*) > 0 as extension_loaded 
FROM pg_extension WHERE extname = 'trace';
 extension_loaded 
------------------
 t
(1 row)

-- 检查索引表是否为空
SELECT COUNT(*) as octree_leaf_count FROM tsdmp_octree_leaf;
 octree_leaf_count 
-------------------
                 0
(1 row)

SELECT COUNT(*) as leaf_bucket_count FROM tsdmp_leaf_bucket;
 leaf_bucket_count 
-------------------
                 0
(1 row)

SELECT COUNT(*) as bucket_kdleaf_count FROM tsdmp_bucket_kdleaf;
 bucket_kdleaf_count 
---------------------
                   0
(1 row)

-- 测试2: 基本配置测试
SELECT 'Testing configuration functions' as test_phase;
       test_phase        
-------------------------
 Testing configuration functions
(1 row)


-- 测试3: 数据加载测试
SELECT 'Testing data loading' as test_phase;
    test_phase     
-------------------
 Testing data loading
(1 row)


-- 加载测试数据
\set datadir :abs_srcdir '/data'
SELECT trace_load_data(:'datadir', 10, 1.0) as load_result;
                     load_result                      
------------------------------------------------------
 (3,30,0.001,116.390000,116.400900,39.900000,39.910900,5.000000,15.900000,1000.000000,3009.000000,1002,10.000000,/home/zyl/zhangteng/postgres/contrib/trace/data)
(1 row)

-- 验证加载结果
SELECT 
    (load_result).files_loaded as files_loaded,
    (load_result).total_points as total_points,
    (load_result).load_time_seconds > 0 as has_load_time
FROM (
    SELECT trace_load_data(:'datadir', 3, 1.0) as load_result
) t;
 files_loaded | total_points | has_load_time 
--------------+--------------+---------------
            3 |           30 | t
(1 row)

-- 验证边界信息
SELECT 
    (load_result).min_x,
    (load_result).max_x,
    (load_result).min_y, 
    (load_result).max_y,
    (load_result).min_z,
    (load_result).max_z
FROM (
    SELECT trace_load_data(:'datadir', 3, 1.0) as load_result
) t;
   min_x   |   max_x   |   min_y   |   max_y   | min_z |  max_z  
-----------+-----------+-----------+-----------+-------+---------
 116.39000 | 116.40090 | 39.900000 | 39.910900 | 5.000 | 15.9000
(1 row)

