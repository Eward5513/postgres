-- 查询最近的点并显示详细信息
SELECT 
    ROUND(distance::numeric, 6) as rounded_distance,
    (point).x, (point).y, (point).z,
    (point).time_stamp,
    (point).file_id, (point).point_id
FROM trace_knn_query(116.3974, 39.9042, 10.5, 3, '-infinity'::REAL, 'infinity'::REAL, 7)
ORDER BY distance;
 rounded_distance |    x    |    y    |  z  | time_stamp | file_id | point_id 
------------------+---------+---------+-----+------------+---------+----------
         0.000000 | 116.397 | 39.9042 | 10.5|       1000 |       1 |        1
         0.000141 | 116.398 | 39.9043 | 10.6|       1001 |       1 |        2
         0.000283 | 116.398 | 39.9044 | 10.7|       1002 |       1 |        3
(3 rows)

