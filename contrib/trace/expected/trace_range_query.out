-- 测试5: 具体点数据检查
SELECT 'Testing specific point data' as test_phase;
      test_phase       
-----------------------
 Testing specific point data
(1 row)

-- 查询并显示部分具体点数据
SELECT 
    x, y, z, time_stamp, data_type, file_id, point_id
FROM trace_range_query(116.397, 39.904, 10.0, 116.398, 39.905, 11.0, 1000.0, 1010.0, 7)
ORDER BY time_stamp
LIMIT 5;
    x    |    y    |  z  | time_stamp | data_type | file_id | point_id 
---------+---------+-----+------------+-----------+---------+----------
 116.397 | 39.9042 | 10.5|       1000 |         1 |       1 |        1
 116.398 | 39.9043 | 10.6|       1001 |         1 |       1 |        2
 116.398 | 39.9044 | 10.7|       1002 |         1 |       1 |        3
 116.398 | 39.9045 | 10.8|       1003 |         1 |       1 |        4
 116.398 | 39.9046 | 10.9|       1004 |         1 |       1 |        5
(5 rows)

