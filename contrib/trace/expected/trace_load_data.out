-- Check specific face data (first few faces)
SELECT 
    file_id,
    face_id,
    vertex_count,
    vertex_indices
FROM mesh 
WHERE file_id = 0 AND face_id <= 5
ORDER BY face_id;
 file_id | face_id | vertex_count | vertex_indices 
---------+---------+--------------+----------------
       0 |       1 |            3 | {1,2,4}
       0 |       2 |            3 | {2,3,5}
       0 |       3 |            3 | {3,6,5}
       0 |       4 |            3 | {4,5,6}
       0 |       5 |            3 | {1,4,7}
