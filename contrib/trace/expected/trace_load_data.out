-- Check specific vertex data (first few vertices)
SELECT 
    file_id,
    vertex_id,
    x,
    y,
    z
FROM point_cloud 
WHERE file_id = 0 AND vertex_id <= 5
ORDER BY vertex_id;
 file_id | vertex_id | x | y | z 
---------+-----------+---+---+---
       0 |         1 | 0 | 0 | 0
       0 |         2 | 1 | 0 | 0
       0 |         3 | 2 | 0 | 0
       0 |         4 | 0 | 1 | 0
       0 |         5 | 1 | 1 | 0
(5 rows)

