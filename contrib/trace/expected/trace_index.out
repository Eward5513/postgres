--
-- trace_index.sql
-- 索引构建测试
--
-- directory paths are passed to us in environment variables
\getenv abs_srcdir PG_ABS_SRCDIR
-- 加载trace扩展
CREATE EXTENSION IF NOT EXISTS trace;
NOTICE:  extension "trace" already exists, skipping
-- 测试1: 准备数据
SELECT 'Preparing data for index building' as test_phase;
            test_phase             
-----------------------------------
 Preparing data for index building
(1 row)

-- 加载测试数据（不测试加载时间）
\set datadir :abs_srcdir '/data'
SELECT 
    (result).files_loaded as files_loaded,
    (result).total_points as total_points
FROM (
    SELECT trace_load_data(:'datadir', 3, 1.0) as result
) t;
NOTICE:  === Suggested GUC Parameters for 30 data points ===
NOTICE:  SET trace.max_point_per_leaf = 50;
NOTICE:  SET trace.bucket_max_points = 8;
NOTICE:  SET trace.kd_leaf_max_points = 4;
NOTICE:  Estimated index structure: 1 outer leaves, 4 buckets, 8 kd leaves
NOTICE:  ====================================================
 files_loaded | total_points 
--------------+--------------
            3 |           30
(1 row)

-- 测试2: 索引构建测试
SELECT 'Testing index building' as test_phase;
       test_phase       
------------------------
 Testing index building
(1 row)

-- 设置GUC参数以获得更细粒度的树结构
SET trace.max_point_per_leaf = 10;
SET trace.bucket_max_points = 4;
SET trace.kd_leaf_max_points = 2;
-- 构建索引（不测试构建时间）
SELECT 
    (result).chunk_count as chunk_count,
    (result).total_octree_nodes as octree_nodes,
    (result).total_kdtree_nodes as kdtree_nodes
FROM (
    SELECT trace_build_index() as result
) t;
 chunk_count | octree_nodes | kdtree_nodes 
-------------+--------------+--------------
           4 |           11 |           17
(1 row)

-- 测试3: 验证索引表数据
SELECT 'Verifying index table data' as test_phase;
         test_phase         
----------------------------
 Verifying index table data
(1 row)

-- 检查octree叶子表
SELECT COUNT(*) as octree_leaf_count FROM trace_octree_leaf;
 octree_leaf_count 
-------------------
                 4
(1 row)

SELECT dataset_path, COUNT(*) as leaf_count 
FROM trace_octree_leaf 
GROUP BY dataset_path;
                  dataset_path                   | leaf_count 
-------------------------------------------------+------------
 /home/zyl/zhangteng/postgres/contrib/trace/data |          4
(1 row)

-- 检查叶内桶表
SELECT COUNT(*) as leaf_bucket_count FROM trace_leaf_bucket;
 leaf_bucket_count 
-------------------
                11
(1 row)

SELECT dataset_path, COUNT(*) as bucket_count 
FROM trace_leaf_bucket 
GROUP BY dataset_path;
                  dataset_path                   | bucket_count 
-------------------------------------------------+--------------
 /home/zyl/zhangteng/postgres/contrib/trace/data |           11
(1 row)

-- 检查桶内kd叶表
SELECT COUNT(*) as bucket_kdleaf_count FROM trace_bucket_kdleaf;
 bucket_kdleaf_count 
---------------------
                  17
(1 row)

SELECT dataset_path, COUNT(*) as kdleaf_count 
FROM trace_bucket_kdleaf 
GROUP BY dataset_path;
                  dataset_path                   | kdleaf_count 
-------------------------------------------------+--------------
 /home/zyl/zhangteng/postgres/contrib/trace/data |           17
(1 row)

-- 测试4: 索引完整性检查
SELECT 'Testing index integrity' as test_phase;
       test_phase        
-------------------------
 Testing index integrity
(1 row)

-- 检查所有叶子的边界框是否合理
SELECT 
    COUNT(*) as total_leaves,
    COUNT(CASE WHEN minx <= maxx AND miny <= maxy AND minz <= maxz THEN 1 END) as valid_bounds
FROM trace_octree_leaf;
 total_leaves | valid_bounds 
--------------+--------------
            4 |            4
(1 row)

-- 检查桶的层级结构
SELECT 
    level, 
    COUNT(*) as bucket_count,
    MIN(count) as min_points,
    MAX(count) as max_points,
    AVG(count) as avg_points
FROM trace_leaf_bucket
GROUP BY level
ORDER BY level;
 level | bucket_count | min_points | max_points |     avg_points     
-------+--------------+------------+------------+--------------------
     0 |            1 |          2 |          2 | 2.0000000000000000
     1 |            2 |          4 |          4 | 4.0000000000000000
     2 |            8 |          2 |          3 | 2.5000000000000000
(3 rows)

-- 测试5: 多次构建测试
SELECT 'Testing multiple index builds' as test_phase;
          test_phase           
-------------------------------
 Testing multiple index builds
(1 row)

-- 保持相同的GUC设置
SET trace.max_point_per_leaf = 10;
SET trace.bucket_max_points = 4;
SET trace.kd_leaf_max_points = 2;
-- 再次构建索引（应该清理并重建，不测试构建时间）
SELECT 
    (result).chunk_count as chunk_count,
    (result).total_octree_nodes as octree_nodes,
    (result).total_kdtree_nodes as kdtree_nodes
FROM (
    SELECT trace_build_index() as result
) t;
 chunk_count | octree_nodes | kdtree_nodes 
-------------+--------------+--------------
           4 |           11 |           17
(1 row)

-- 验证重建后的数据一致性
SELECT 
    (SELECT COUNT(*) FROM trace_octree_leaf) as octree_count,
    (SELECT COUNT(*) FROM trace_leaf_bucket) as bucket_count,
    (SELECT COUNT(*) FROM trace_bucket_kdleaf) as kdleaf_count;
 octree_count | bucket_count | kdleaf_count 
--------------+--------------+--------------
            4 |           11 |           17
(1 row)

-- 测试完成
SELECT 'Index building tests completed successfully' as final_status;
                final_status                 
---------------------------------------------
 Index building tests completed successfully
(1 row)

